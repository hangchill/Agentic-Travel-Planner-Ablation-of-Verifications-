# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
# The group's OpenRouter API key is private — get it from a teammate, never commit it.
OPENROUTER_API_KEY=sk-or-v1-your-group-key-here

# OpenRouter uses an OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model for the planning agent (override per-experiment as needed).
# openai/gpt-4.1 matches the proposal; swap to a cheaper model while developing.
PLANNER_MODEL=openai/gpt-4.1
PLANNER_TEMPERATURE=0.7
