# Copy this file to `.env` and fill in the real values since `.env` is gitignored.

# Add in the API KEY
OPENROUTER_API_KEY=TBC_API_KEY

# OpenRouter uses an OpenAI-compatible endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model for the planning agent
PLANNER_MODEL=openai/gpt-4.1
PLANNER_TEMPERATURE=0.7
